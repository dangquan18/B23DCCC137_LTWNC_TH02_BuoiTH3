# Bắt buộc: chuỗi bí mật ký JWT (tạo bằng: npx auth secret  hoặc  openssl rand -base64 32)
AUTH_SECRET=thay-bang-chuoi-ngau-nhien-dai

# URL công khai của site (dùng cho metadataBase, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tuỳ chọn (điểm cộng): đăng nhập GitHub OAuth
# Callback URL khai báo trên GitHub: <SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
